---
// src/pages/security.astro - Security & Compliance Overview Page
import Layout from '../layouts/Layout.astro';
import HeaderNav from '../components/HeaderNav.astro';
import Footer from '../components/Footer.astro';
import { SITE_CONFIG } from '../config/site';
---

<Layout
  title={`Security & Compliance | ${SITE_CONFIG.name}`}
  description="PCI-DSS Level 1 compliance, TLS 256-bit encryption, tokenization, and multi-gateway failover security standards."
>
  <HeaderNav />

  <main class="legal-page">
    <div class="container legal-container">
      <div class="legal-header">
        <a href="/" class="back-link">← Back to Home</a>
        <h1 class="legal-title">Security &amp; Compliance Standards</h1>
        <p class="legal-meta">Bank-Grade Infrastructure &amp; Multi-Gateway Protection · OneFunding LLC</p>
      </div>

      <div class="legal-content">
        <section>
          <h2>1. PCI-DSS Level 1 Validated Processing</h2>
          <p>
            All payment transactions processed across our partner network adhere to the highest standard established by the Payment Card Industry Security Standards Council (PCI-DSS Level 1). Cardholder data is tokenized immediately at the point of sale or virtual terminal and is never stored in unencrypted form on web servers.
          </p>
        </section>

        <section>
          <h2>2. 256-Bit TLS End-to-End Encryption</h2>
          <p>
            All digital interactions, statement uploads, API requests, and web sessions use high-grade 256-bit Transport Layer Security (TLS 1.3) encryption. Data in transit and at rest remains secure against interception.
          </p>
        </section>

        <section>
          <h2>3. Multi-Gateway Failover &amp; Redundancy Architecture</h2>
          <p>
            To guarantee our 99.9% uptime SLA, OneFunding routes transactions through multi-gateway orchestrators (including NMI, Authorize.Net, and Fluidpay). In the event of an upstream banking or network timeout, transactions are automatically rerouted through secondary acquiring pathways to prevent lost sales.
          </p>
        </section>

        <section>
          <h2>4. Chargeback Defense &amp; Real-Time Fraud Prevention</h2>
          <p>
            Our infrastructure integrates directly with major chargeback mitigation networks (Verifi CDRN and Ethoca Alerts). This gives merchants up to 72 hours to resolve customer inquiries before an automated chargeback is filed, protecting MID health and preventing processing caps.
          </p>
        </section>

        <section>
          <h2>5. LegitScript Certified Underwriting</h2>
          <p>
            For regulated and high-growth sectors (including telemedicine, nutraceuticals, and subscription billing), OneFunding collaborates with LegitScript certified underwriting protocols to ensure compliance with card brand standards and eliminate sudden automated account closures.
          </p>
        </section>
      </div>

      <div class="legal-cta-banner">
        <h3>Experience Enterprise-Grade Payment Security</h3>
        <p>Switch to resilient, multi-gateway merchant processing today.</p>
        <a href={SITE_CONFIG.ctaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <span>{SITE_CONFIG.ctaText} →</span>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .legal-page {
    padding: 4rem 0 6rem 0;
    background-color: var(--bg-page);
    min-height: 80vh;
  }

  .legal-container {
    max-width: 820px;
    margin: 0 auto;
  }

  .legal-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-light);
  }

  .back-link {
    display: inline-block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--emerald-primary);
    margin-bottom: 1rem;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--emerald-hover);
  }

  .legal-title {
    font-size: 2.4rem;
    color: var(--text-heading);
    margin-bottom: 0.5rem;
  }

  .legal-meta {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .legal-content {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .legal-content section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .legal-content h2 {
    font-size: 1.35rem;
    color: var(--text-heading);
    margin-top: 0.5rem;
  }

  .legal-content p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-body);
  }

  .legal-cta-banner {
    margin-top: 4rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .legal-cta-banner h3 {
    font-size: 1.45rem;
    color: var(--text-heading);
  }

  .legal-cta-banner p {
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }
</style>
