---
// AuthorityBar.astro - Clean Authentic Gateway & Compliance Partner Bar (Indigo & Mint Scheme)
---

<section class="authority-bar-clean">
  <div class="container">
    <div class="authority-header text-center">
      <span class="authority-label">
        PROCESSED OVER <span class="counter-highlight">$<span id="live-counter">2,345,678</span></span> AND GROWING
      </span>
    </div>

    <!-- Clean Metric Stat Row -->
    <div class="stats-clean-row">
      <div class="stat-clean-item">
        <div class="stat-clean-num">135+</div>
        <div class="stat-clean-lbl">Currencies &amp; Crypto</div>
      </div>
      <div class="stat-clean-item">
        <div class="stat-clean-num text-mint">99.9%</div>
        <div class="stat-clean-lbl">Uptime SLA Guarantee</div>
      </div>  
      <div class="stat-clean-item">
        <div class="stat-clean-num">50+</div>
        <div class="stat-clean-lbl">Specialized Industries</div>
      </div>
      <div class="stat-clean-item">
        <div class="stat-clean-num text-indigo">24–48h</div>
        <div class="stat-clean-lbl">Custom Approvals</div>
      </div>
      <div class="stat-clean-item">
        <div class="stat-clean-num">$2.8M+</div>
        <div class="stat-clean-lbl">Processed Daily</div>
      </div>
    </div>
  </div>
</section>

<!-- Sleek Section Divider -->
<div class="divider-slash-tilted" aria-hidden="true"></div>

<style>
  .authority-bar-clean {
    background: var(--bg-subtle);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    padding: 2.25rem 0;
  }

  .authority-header {
    margin-bottom: 1.5rem;
  }

  .authority-label {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .counter-highlight {
    color: var(--indigo-primary);
    background: var(--indigo-bg);
    border: 1px solid var(--indigo-border);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    display: inline-block;
  }

  /* Stats Clean Row */
  .stats-clean-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-light);
    text-align: center;
  }

  .stat-clean-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-clean-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-heading);
    line-height: 1.1;
  }

  .text-indigo {
    color: var(--indigo-primary);
  }

  .text-mint {
    color: var(--mint-primary);
  }

  .stat-clean-lbl {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 0.3rem;
    font-weight: 500;
  }

  @media (max-width: 800px) {
    .stats-clean-row {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem 1rem;
    }

    .stat-clean-item:nth-child(4) {
      grid-column: span 1;
    }

    .stat-clean-item:nth-child(5) {
      grid-column: span 2;
    }
  }

  @media (max-width: 520px) {
    .stats-clean-row {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem 0.75rem;
    }

    .stat-clean-item:nth-child(5) {
      grid-column: span 2;
    }
  }
</style>

<script>
  // Live Activity Counter
  const counterElement = document.getElementById('live-counter');
  if (counterElement) {
    let currentValue = 2345678;
    setInterval(() => {
      const increment = Math.floor(Math.random() * 800) + 100;
      currentValue += increment;
      counterElement.textContent = currentValue.toLocaleString('en-US');
    }, 1200);
  }
</script>
