---
// RateAnalysisForm.astro - Clean Light-Theme B2B Rate Analysis Lead Capture Form
import { SITE_CONFIG } from '../config/site';
---

<div class="audit-form-clean" id="auditForm">
  <div class="form-header text-center">
    <div class="badge-tag">
      <span class="pulse-dot-green"></span>
      <span>100% FREE · NO OBLIGATION · 24H AUDIT</span>
    </div>
    <h3 class="form-main-heading">Claim Your Free Rate Analysis & Savings Audit</h3>
    <p class="form-main-sub">
      Submit your processing volume below. A senior Payment Strategist will analyze your statement and deliver your itemized fee savings report.
    </p>
  </div>

  <form class="lead-form" id="leadCaptureForm">
    <!-- Row 1: Name & Email -->
    <div class="form-row">
      <div class="form-group">
        <label for="fullName" class="form-label">Full Name *</label>
        <input 
          type="text" 
          id="fullName" 
          name="fullName" 
          class="form-control" 
          placeholder="Sarah Jenkins" 
          required 
        />
      </div>

      <div class="form-group">
        <label for="workEmail" class="form-label">Business Email *</label>
        <input 
          type="email" 
          id="workEmail" 
          name="workEmail" 
          class="form-control" 
          placeholder="sarah@yourcompany.com" 
          required 
        />
      </div>
    </div>

    <!-- Row 2: Phone & Company Name -->
    <div class="form-row">
      <div class="form-group">
        <label for="phoneNumber" class="form-label">Direct Phone / Mobile *</label>
        <input 
          type="tel" 
          id="phoneNumber" 
          name="phoneNumber" 
          class="form-control" 
          placeholder="(555) 000-0000" 
          required 
        />
      </div>

      <div class="form-group">
        <label for="companyName" class="form-label">Company / Brand Name *</label>
        <input 
          type="text" 
          id="companyName" 
          name="companyName" 
          class="form-control" 
          placeholder="Apex Commerce LLC" 
          required 
        />
      </div>
    </div>

    <!-- Row 3: Monthly Volume & Current Processor -->
    <div class="form-row">
      <div class="form-group">
        <label for="monthlyVolume" class="form-label">Monthly Processing Volume *</label>
        <select id="monthlyVolume" name="monthlyVolume" class="form-control" required>
          <option value="" disabled selected>Select Monthly Volume</option>
          <option value="10k-25k">$10,000 – $25,000 / month</option>
          <option value="25k-50k">$25,000 – $50,000 / month</option>
          <option value="50k-100k">$50,000 – $100,000 / month</option>
          <option value="100k-250k">$100,000 – $250,000 / month</option>
          <option value="250k-500k">$250,000 – $500,000 / month</option>
          <option value="500k-plus">$500,000+ / month (Enterprise)</option>
        </select>
      </div>

      <div class="form-group">
        <label for="currentProcessor" class="form-label">Current Payment Processor *</label>
        <select id="currentProcessor" name="currentProcessor" class="form-control" required>
          <option value="" disabled selected>Select Current Processor</option>
          <option value="stripe">Stripe</option>
          <option value="square">Square</option>
          <option value="paypal">PayPal / Braintree</option>
          <option value="authorize">Authorize.Net</option>
          <option value="clover">Clover / Fiserv</option>
          <option value="other">Other / Multiple Gateways</option>
        </select>
      </div>
    </div>

    <!-- Optional File Upload for Statement Audit -->
    <div class="form-group">
      <label for="statementFile" class="form-label">
        Upload Recent Processing Statement <span class="text-muted">(Optional for Faster 24h Audit)</span>
      </label>
      <div class="dropzone-box" id="fileDropzone">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
        <span class="dropzone-text" id="fileNameLabel">Drag & drop your statement PDF/CSV or click to browse</span>
        <input type="file" id="statementFile" name="statementFile" accept=".pdf,.csv,.xlsx,.png,.jpg" class="file-input" />
      </div>
    </div>

    <!-- Submit CTA Button -->
    <button type="submit" class="btn btn-primary btn-lg btn-full submit-btn" id="submitBtn">
      <span>GET MY FREE RATE ANALYSIS REPORT →</span>
    </button>

    <!-- FUD Protection Row -->
    <div class="fud-list form-fud-row">
      <div class="fud-item"><span class="fud-check">✓</span> 100% Confidential & Secure</div>
      <div class="fud-item"><span class="fud-check">✓</span> Zero Obligation to Switch</div>
      <div class="fud-item"><span class="fud-check">✓</span> Report Delivered in &lt;24 Hours</div>
    </div>
  </form>

  <!-- Success Confirmation Box -->
  <div class="form-success-box" id="formSuccessMessage" style="display: none;">
    <div class="success-icon">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
    </div>
    <h3 class="success-heading">Rate Analysis Request Received</h3>
    <p class="success-sub">
      Thank you, <span id="successName">Merchant</span>! A Senior Payment Strategist is now compiling your customized rate comparison report.
    </p>
    <a href={SITE_CONFIG.phone.href} class="btn btn-primary">
      <span>Call Directly for Expedited Review: {SITE_CONFIG.phone.display}</span>
    </a>
  </div>
</div>

<style>
  .audit-form-clean {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: 3rem;
    box-shadow: var(--shadow-lg);
    max-width: 820px;
    margin: 0 auto;
  }

  .form-header {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }

  .form-main-heading {
    font-size: 1.65rem;
    color: var(--text-heading);
  }

  .form-main-sub {
    font-size: 0.96rem;
    color: var(--text-muted);
    max-width: 580px;
  }

  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.15rem;
  }

  .dropzone-box {
    position: relative;
    border: 1.5px dashed var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    background: var(--bg-subtle);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .dropzone-box:hover {
    border-color: var(--emerald-primary);
    background: var(--emerald-bg);
  }

  .dropzone-text {
    font-size: 0.86rem;
    color: var(--text-muted);
    text-align: center;
  }

  .file-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .submit-btn {
    margin-top: 0.75rem;
    padding: 1.05rem;
  }

  .form-fud-row {
    margin-top: 1rem;
    font-size: 0.82rem;
  }

  /* Success Box */
  .form-success-box {
    text-align: center;
    padding: 2.5rem 1rem;
  }

  .success-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--emerald-bg);
    border: 1.5px solid var(--emerald-border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem auto;
  }

  .success-heading {
    font-size: 1.6rem;
    color: var(--text-heading);
    margin-bottom: 0.5rem;
  }

  .success-sub {
    font-size: 0.98rem;
    color: var(--text-body);
    max-width: 480px;
    margin: 0 auto 1.75rem auto;
  }

  @media (max-width: 768px) {
    .audit-form-clean {
      padding: 1.75rem;
    }

    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>

<script>
  function initForm() {
    const form = document.getElementById('leadCaptureForm') as HTMLFormElement;
    const fileInput = document.getElementById('statementFile') as HTMLInputElement;
    const fileLabel = document.getElementById('fileNameLabel');
    const successBox = document.getElementById('formSuccessMessage');
    const successName = document.getElementById('successName');
    const submitBtn = document.getElementById('submitBtn');

    if (fileInput && fileLabel) {
      fileInput.addEventListener('change', () => {
        if (fileInput.files && fileInput.files[0]) {
          fileLabel.textContent = '📄 ' + fileInput.files[0].name + ' (Attached)';
          fileLabel.style.color = '#059669';
        }
      });
    }

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const nameVal = formData.get('fullName') as string || 'Merchant';

        if (submitBtn) {
          submitBtn.innerHTML = '<span>Processing Secure Request...</span>';
          submitBtn.setAttribute('disabled', 'true');
        }

        setTimeout(() => {
          form.style.display = 'none';
          if (successBox) {
            successBox.style.display = 'block';
          }
          if (successName) {
            successName.textContent = nameVal;
          }
        }, 600);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initForm);
  } else {
    initForm();
  }
</script>
