---
// SocialProofSection.astro - Clean Light Case Studies & Verified Results (No Carousels)
---

<section class="section section-white social-proof-section" id="testimonials">
  <div class="container">
    <div class="section-header-clean">
      <h2>
        Real Merchants. Verifiable Savings. Zero Frozen Funds.
      </h2>
      <p>
        See how scaling brands switched from flat-rate aggregators to OneFunding Interchange-Plus and unlocked true next-day cash flow.
      </p>
    </div>

    <!-- 3-Column Verifiable Testimonials Grid -->
    <div class="testimonials-clean-grid">
      <!-- Story 1 -->
      <div class="testimonial-box">
        <div class="testi-header">
          <div class="rating-stars">★★★★★</div>
          <div class="verified-tag">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Verified Merchant</span>
          </div>
        </div>

        <p class="testi-quote">
          "Stripe placed an <strong>$85,000 rolling reserve</strong> on our account right in the middle of our Q4 supplement product launch. OneFunding got us LegitScript-underwritten and live on multi-gateway routing in 36 hours. We saved <strong>$18,400 in processing fees</strong> in year one."
        </p>

        <div class="testi-author">
          <div class="testi-avatar avatar-green">MV</div>
          <div>
            <div class="testi-name">Marcus Vance</div>
            <div class="testi-role">Founder, Apex Nutraceuticals</div>
          </div>
        </div>
      </div>

      <!-- Story 2 -->
      <div class="testimonial-box">
        <div class="testi-header">
          <div class="rating-stars">★★★★★</div>
          <div class="verified-tag">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Verified Merchant</span>
          </div>
        </div>

        <p class="testi-quote">
          "Moving from a flat 3.5% aggregator fee to OneFunding's Interchange-Plus gave us an immediate <strong>32% reduction in transaction fees</strong>. Next-day cash deposits completely transformed how quickly we restock inventory."
        </p>

        <div class="testi-author">
          <div class="testi-avatar avatar-blue">ER</div>
          <div>
            <div class="testi-name">Elena Rostova</div>
            <div class="testi-role">COO, LuxeCart E-Commerce</div>
          </div>
        </div>
      </div>

      <!-- Story 3 -->
      <div class="testimonial-box">
        <div class="testi-header">
          <div class="rating-stars">★★★★★</div>
          <div class="verified-tag">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Verified Merchant</span>
          </div>
        </div>

        <p class="testi-quote">
          "We process payments internationally in 14 currencies. OneFunding connected to our custom API in two days, gave us <strong>automated failover between NMI and Authorize.Net</strong>, and authorization rates increased to 99.4%."
        </p>

        <div class="testi-author">
          <div class="testi-avatar avatar-indigo">DS</div>
          <div>
            <div class="testi-name">David Sterling</div>
            <div class="testi-role">VP Infrastructure, CloudSync AI</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Open-Air Trust & Compliance Proof Bar (No Card Container) -->
    <div class="trust-proof-bar" aria-label="Security and Verified Ratings">
      <div class="trust-proof-item">
        <div class="proof-icon-wrap icon-google">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
          </svg>
        </div>
        <div class="proof-text-group">
          <div class="proof-headline">
            <span class="proof-stars">★★★★★</span>
            <strong>4.7 / 5.0</strong>
          </div>
          <span class="proof-subtext">280+ Verified Reviews</span>
        </div>
      </div>

      <div class="proof-bar-divider" aria-hidden="true"></div>

      <div class="trust-proof-item">
        <div class="proof-icon-wrap icon-security">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <div class="proof-text-group">
          <span class="proof-main">PCI-DSS Level 1</span>
          <span class="proof-subtext">Bank-Grade Encryption</span>
        </div>
      </div>

      <div class="proof-bar-divider" aria-hidden="true"></div>

      <div class="trust-proof-item">
        <div class="proof-icon-wrap icon-shield">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.2">
            <circle cx="12" cy="12" r="10"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <div class="proof-text-group">
          <span class="proof-main">LegitScript Certified</span>
          <span class="proof-subtext">Underwriting Partner</span>
        </div>
      </div>

      <div class="proof-bar-divider" aria-hidden="true"></div>

      <div class="trust-proof-item">
        <div class="proof-icon-wrap icon-bbb">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2">
            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
            <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
            <path d="M4 22h16"/>
            <path d="M10 14.66V17c0 .55-.45 1-1 1H7c-.55 0-1-.45-1-1v-2.34c0-.38.22-.73.56-.89l2.88-1.44a1 1 0 0 0 .56-.89V8c0-.55-.45-1-1-1H7c-.55 0-1 .45-1 1"/>
            <path d="M14 14.66V17c0 .55.45 1 1 1h2c.55 0 1-.45 1-1v-2.34c0-.38-.22-.73-.56-.89l-2.88-1.44a1 1 0 0 1-.56-.89V8c0-.55.45-1 1-1h2c.55 0 1 .45 1 1"/>
          </svg>
        </div>
        <div class="proof-text-group">
          <span class="proof-main">BBB Accredited A+</span>
          <span class="proof-subtext">Verified Business Standards</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-clean-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .testimonial-box {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all var(--transition-normal);
  }

  .testimonial-box:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--border-subtle);
    transform: translateY(-2px);
  }

  .testi-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.15rem;
  }

  .rating-stars {
    color: #f59e0b;
    font-size: 1rem;
    letter-spacing: 0.05em;
  }

  .verified-tag {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    background: var(--emerald-bg);
    border: 1px solid var(--emerald-border);
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--emerald-primary);
  }

  .testi-quote {
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 1.5rem;
  }

  .testi-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
  }

  .testi-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.85rem;
    color: #ffffff;
  }

  .avatar-green {
    background: var(--emerald-primary);
  }

  .avatar-blue {
    background: var(--cyan-primary);
  }

  .avatar-indigo {
    background: var(--indigo-primary);
  }

  .testi-name {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-heading);
  }

  .testi-role {
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  /* Open-Air Trust & Compliance Proof Bar (No Card) */
  .trust-proof-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2.5rem;
    margin-top: 1rem;
    border-top: 1px solid var(--border-light);
    gap: 1.5rem;
  }

  .trust-proof-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex: 1;
  }

  .proof-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: #f8fafc;
    border: 1px solid var(--border-light);
  }

  .icon-google {
    background: #ffffff;
  }

  .icon-security {
    background: var(--emerald-bg);
    border-color: var(--emerald-border);
  }

  .icon-shield {
    background: var(--indigo-bg);
    border-color: var(--indigo-border);
  }

  .icon-bbb {
    background: var(--cyan-bg);
    border-color: var(--cyan-border);
  }

  .proof-text-group {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .proof-headline {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    color: var(--text-heading);
  }

  .proof-stars {
    color: #f59e0b;
    font-size: 0.82rem;
    letter-spacing: 0.05em;
  }

  .proof-main {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-heading);
    line-height: 1.25;
  }

  .proof-subtext {
    font-size: 0.76rem;
    color: var(--text-muted);
    line-height: 1.2;
  }

  .proof-bar-divider {
    width: 1px;
    height: 36px;
    background: var(--border-light);
    flex-shrink: 0;
  }

  @media (max-width: 990px) {
    .trust-proof-bar {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }

    .proof-bar-divider {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .testimonials-clean-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 550px) {
    .trust-proof-bar {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
