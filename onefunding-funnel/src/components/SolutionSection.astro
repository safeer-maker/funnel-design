---
// SolutionSection.astro - Clean Open-Air Solution Architecture (Color-Coded Numbers + Checkmarks Left, 2:3 Photo Right)
---

<section class="section section-white solution-section" id="solution">
  <div class="container">

    <!-- Section Header -->
    <div class="section-header-clean">
      <h2>
        Payment Infrastructure Built to Protect Your Cash Flow
      </h2>
      <p>
        Most processors treat your business like an automated risk equation. OneFunding acts as an infrastructure partner, custom-underwriting your account upfront so your revenue stays secure.
      </p>
    </div>

    <!-- 2-Column Layout: Solution Points Left, 2:3 Organic Visual Right -->
    <div class="solution-layout-grid">

      <!-- LEFT: Color-Coded Numbered Points with Checkmark Blocks -->
      <div class="solution-points-col">

        <!-- Point 01 -->
        <div class="solution-point point-emerald" data-animate>
          <div class="solution-header-row">
            <h3 class="solution-title">Interchange-Plus Pricing</h3>
          </div>
          <ul class="solution-checklist">
            <li>
              <span class="check-icon icon-emerald">✓</span>
              <span>True wholesale network pass-through without hidden markups</span>
            </li>
            <li>
              <span class="check-icon icon-emerald">✓</span>
              <span>Next business day direct deposit funding into your bank</span>
            </li>
            <li>
              <span class="check-icon icon-emerald">✓</span>
              <span>Zero cancellation penalties or long-term lock-in contracts</span>
            </li>
          </ul>
        </div>

        <!-- Point 02 -->
        <div class="solution-point point-indigo" data-animate>
          <div class="solution-header-row">
            <h3 class="solution-title">Multi-Gateway Failover & Smart Routing</h3>
          </div>
          <ul class="solution-checklist">
            <li>
              <span class="check-icon icon-indigo">✓</span>
              <span>Intelligent load-balancing for peak sales volumes</span>
            </li>
            <li>
              <span class="check-icon icon-indigo">✓</span>
              <span>Automated secondary bank retries on soft processor declines</span>
            </li>
            <li>
              <span class="check-icon icon-indigo">✓</span>
              <span>Multi-MID orchestration across separate acquiring banks</span>
            </li>
          </ul>
        </div>

        <!-- Point 03 -->
        <div class="solution-point point-amber" data-animate>
          <div class="solution-header-row">
            <h3 class="solution-title">Upfront Human Underwriting & Defense</h3>
          </div>
          <ul class="solution-checklist">
            <li>
              <span class="check-icon icon-amber">✓</span>
              <span>LegitScript & high-growth compliance expertise</span>
            </li>
            <li>
              <span class="check-icon icon-amber">✓</span>
              <span>Built-in chargeback alert integrations (Verifi & Ethoca)</span>
            </li>
            <li>
              <span class="check-icon icon-amber">✓</span>
              <span>Dedicated direct-line merchant account manager</span>
            </li>
          </ul>
        </div>

      </div>

      <!-- RIGHT: 2:3 Organic Photography -->
      <div class="solution-visual-col">
        <div class="solution-image-sticky">
          <div class="solution-image-frame">
            <img
              src="/images/cafe_owner_pos.jpg"
              alt="Happy business manager operating sleek tablet POS in a bright modern cafe"
              class="solution-photo"
              loading="lazy"
              width="800"
              height="1200"
            />
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .solution-section {
    position: relative;
    padding: 5rem 0;
  }

  /* ===== 2-Column Solution Layout ===== */
  .solution-layout-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 4.5rem;
    align-items: center;
    margin-top: 3rem;
  }

  /* ===== LEFT: Solution Points ===== */
  .solution-points-col {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  .solution-point {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }

  .solution-point.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Header Row: Color-Coded Number + Title */
  .solution-header-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .solution-num {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 900;
    line-height: 1;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-md);
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  /* Color Codes */
  .num-emerald {
    background: var(--emerald-bg);
    color: var(--emerald-primary);
    border: 1px solid var(--emerald-border);
  }

  .num-indigo {
    background: #eef2ff;
    color: #4f46e5;
    border: 1px solid #c7d2fe;
  }

  .num-amber {
    background: #fffbeb;
    color: #d97706;
    border: 1px solid #fde68a;
  }

  .solution-title {
    font-size: 1.35rem;
    color: var(--text-heading);
    font-weight: 700;
    line-height: 1.3;
  }

  /* Checklist Blocks */
  .solution-checklist {
    list-style: none;
    padding: 0;
    margin-left: 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .solution-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.94rem;
    font-weight: 500;
    color: var(--text-body);
    line-height: 1.5;
  }

  .check-icon {
    font-weight: 900;
    font-size: 0.95rem;
    line-height: 1.5;
    flex-shrink: 0;
  }

  .icon-emerald { color: var(--emerald-primary); }
  .icon-indigo  { color: #4f46e5; }
  .icon-amber   { color: #d97706; }

  /* ===== RIGHT: 2:3 Organic Visual ===== */
  .solution-visual-col {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .solution-image-sticky {
    position: sticky;
    top: 100px;
    width: 100%;
    max-width: 440px;
  }

  .solution-image-frame {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 16px 40px -10px rgba(15, 23, 42, 0.08), 0 6px 16px -4px rgba(15, 23, 42, 0.03);
    background: #ffffff;
    border: 1px solid var(--border-light);
  }

  .solution-photo {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 2 / 3;
    transition: transform 0.45s ease;
  }

  .solution-image-frame:hover .solution-photo {
    transform: scale(1.02);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 1024px) {
    .solution-layout-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .solution-image-sticky {
      position: static;
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>

<script>
  function initSolutionAnimations() {
    const points = document.querySelectorAll('.solution-point');
    if (!points.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const index = Array.from(points).indexOf(entry.target);
            setTimeout(() => {
              entry.target.classList.add('is-visible');
            }, index * 120);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    points.forEach((p) => observer.observe(p));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSolutionAnimations);
  } else {
    initSolutionAnimations();
  }
</script>
