---
// FaqSection.astro - 2-Column Editorial FAQ with Sticky Decision Anchor & Open-Air Accordion
import { SITE_CONFIG } from '../config/site';
---

<section class="section section-subtle faq-section" id="faq">
  <div class="container">
    <div class="faq-2col-layout">
      
      <!-- Left Column: Sticky Decision & Action Anchor -->
      <div class="faq-anchor-col">
        <div class="faq-sticky-box">
          <div class="faq-kicker">
            <span class="pulse-dot"></span>
            <span>TRANSPARENT TERMS</span>
          </div>

          <h2 class="faq-anchor-title">
            Everything You Need to Know Before Switching
          </h2>

          <p class="faq-anchor-desc">
            No hidden contract clauses, no automated runaround. We believe in clear terms, wholesale pricing, and direct human accountability from day one.
          </p>

          <div class="faq-action-card">
            <h3 class="action-heading">Ready to see your real savings?</h3>
            <p class="action-sub">
              Upload a recent processing statement for an objective, line-by-line rate audit with zero obligation.
            </p>
            <a href={SITE_CONFIG.ctaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-md faq-cta-btn">
              <span>Get Free Statement Review →</span>
            </a>
            <div class="faq-trust-tags">
              <span>🔒 100% Confidential</span>
              <span>⚡ 24–48h Approvals</span>
              <span>🛡️ 0 Interruption</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Open-Air Hairline Accordion -->
      <div class="faq-content-col">
        <div class="faq-hairline-list">

          <!-- FAQ 1 -->
          <details class="faq-item" open>
            <summary class="faq-question">
              <span>Are there any long-term contracts, lease locks, or cancellation penalties?</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>
                <strong>None.</strong> We operate strictly on a month-to-month basis with zero cancellation fees, zero long-term equipment lock-ins, and zero termination penalties. We believe in continuously earning your business every month through transparent pricing, superior uptime, and dedicated human support.
              </p>
            </div>
          </details>

          <!-- FAQ 2 -->
          <details class="faq-item">
            <summary class="faq-question">
              <span>What is the difference between Dual Pricing and Interchange-Plus?</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>
                <strong>Dual Pricing</strong> allows a business to offset up to 100% of card processing expenses by presenting clear cash and card prices at checkout. <strong>Interchange-Plus</strong> passes through true wholesale Visa/Mastercard interchange rates plus a small, fixed transparent markup—ideal for established merchants and B2B businesses wanting complete cost transparency.
              </p>
            </div>
          </details>

          <!-- FAQ 3 -->
          <details class="faq-item">
            <summary class="faq-question">
              <span>Will switching processors disrupt my active store or sales?</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>
                <strong>Guaranteed zero downtime.</strong> Your existing processor stays 100% active while our onboarding team configures and verifies your new account and hardware in the background. You only switch over once everything is fully tested, ensuring your customers never experience a second of payment delay.
              </p>
            </div>
          </details>

          <!-- FAQ 4 -->
          <details class="faq-item">
            <summary class="faq-question">
              <span>How fast do customer payments settle into my business bank account?</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>
                All daily transaction batches settle via <strong>next-business-day direct deposits</strong> directly into your existing business checking account. There are no arbitrary holding periods or unnecessary payout delays.
              </p>
            </div>
          </details>

          <!-- FAQ 5 -->
          <details class="faq-item">
            <summary class="faq-question">
              <span>What payment hardware and software systems do you support?</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>
                We support modern Smart POS terminals (Pax, Clover, Dejavoo), Tap to Pay on iPhone and Android, browser-based Virtual Terminals, and direct software integrations with QuickBooks, Shopify, WooCommerce, NMI, Authorize.Net, and custom APIs.
              </p>
            </div>
          </details>

          <!-- FAQ 6 -->
          <details class="faq-item">
            <summary class="faq-question">
              <span>What if my current merchant processing rates are already competitive?</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>
                <strong>We will tell you honestly.</strong> Our statement review is an objective, line-by-line audit. If your existing setup is already optimal and you are receiving fair wholesale pricing, we will confirm it for your peace of mind with zero pressure to switch.
              </p>
            </div>
          </details>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     2-COLUMN OPEN-AIR FAQ SECTION (CONCEPT 1)
     ========================================================================== */

  .faq-section {
    padding: 6.5rem 0;
    background-color: var(--bg-page);
    border-top: 1px solid var(--border-light);
  }

  .faq-2col-layout {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 4.5rem;
    align-items: flex-start;
  }

  /* Left Column: Sticky Anchor */
  .faq-anchor-col {
    position: sticky;
    top: 6rem;
  }

  .faq-sticky-box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .faq-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: #f1f5f9;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-heading);
    margin-bottom: 1.25rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--emerald-primary);
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.2);
  }

  .faq-anchor-title {
    font-size: 2.15rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-heading);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .faq-anchor-desc {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 2rem;
  }

  /* Left Column: Compact Action Card */
  .faq-action-card {
    width: 100%;
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-left: 3px solid var(--emerald-primary);
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  }

  .action-heading {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-heading);
    margin-bottom: 0.4rem;
  }

  .action-sub {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .faq-cta-btn {
    width: 100%;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .faq-trust-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  /* Right Column: Open-Air Hairline Accordion */
  .faq-hairline-list {
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-bottom: 1px solid var(--border-light);
    transition: background-color var(--transition-fast);
  }

  .faq-item:first-of-type {
    border-top: 1px solid var(--border-light);
  }

  .faq-question {
    padding: 1.35rem 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-heading);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color var(--transition-fast);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    color: var(--emerald-primary);
  }

  .faq-chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: transform 0.25s ease, color 0.25s ease;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-question {
    color: var(--emerald-primary);
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--emerald-primary);
  }

  .faq-answer {
    padding: 0 0.5rem 1.5rem 0.5rem;
    color: var(--text-body);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .faq-answer strong {
    color: var(--text-heading);
    font-weight: 700;
  }

  /* Responsive Adjustments */
  @media (max-width: 960px) {
    .faq-section {
      padding: 4.5rem 0;
    }

    .faq-2col-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .faq-anchor-col {
      position: static;
    }

    .faq-anchor-title {
      font-size: 1.85rem;
    }
  }
</style>

