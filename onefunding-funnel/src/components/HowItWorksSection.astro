---
// HowItWorksSection.astro - Clean, Human Open-Air Cross-Diagonal Onboarding Experience
import { SITE_CONFIG } from '../config/site';
---

<section class="section how-it-works-diagonal-section" id="howItWorks">
  <!-- Subtle Cross-Diagonal Background Grid Lines -->
  <div class="cross-diagonal-lines" aria-hidden="true">
    <div class="diag-line diag-line-1"></div>
    <div class="diag-line diag-line-2"></div>
  </div>

  <div class="container relative-content">
    <!-- Clean, Focused Section Header -->
    <div class="section-header-clean text-center">
      <h2>
        How We Seamlessly Onboard Your Business
      </h2>
      <p class="section-subtitle">
        Switching payment processors shouldn’t be disruptive. We handle underwriting, configuration, and migration in the background so you never experience a second of payment downtime.
      </p>
    </div>

    <!-- Open-Air Cross-Diagonal Flow (Alternating Left/Right) -->
    <div class="cross-diagonal-rows">

      <!-- Row 1: Image Left, Text Right -->
      <div class="cross-row" data-animate>
        <div class="visual-col">
          <div class="image-frame tilt-left">
            <img 
              src="/images/merchant_operations.jpg" 
              alt="Payment specialist reviewing merchant statement and operational details" 
              class="real-photo"
              loading="lazy"
              width="540"
              height="380"
            />
          </div>
        </div>

        <div class="text-col">
          <span class="phase-label text-indigo">DISCOVERY &amp; AUDIT</span>
          <h3 class="row-title">
            We Review Your Numbers &amp; Uncover Hidden Processor Markups
          </h3>
          <p class="row-desc">
            Provide your estimated monthly volume or share a recent processing statement. A senior payment specialist performs a line-by-line review to show you exact fee markups and where you can eliminate unnecessary charges.
          </p>
          <div class="key-points">
            <div class="point-item">
              <span class="point-check check-indigo">✓</span>
              <span><strong>Itemized Breakdown:</strong> Clear side-by-side comparison with your current setup.</span>
            </div>
            <div class="point-item">
              <span class="point-check check-indigo">✓</span>
              <span><strong>No-Pressure Guarantee:</strong> If your current rates are already competitive, we will tell you.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Cross-Diagonal Intersecting Divider -->
      <div class="cross-slash-divider slash-right" aria-hidden="true">
        <span class="slash-line"></span>
      </div>

      <!-- Row 2: Text Left, Image Right -->
      <div class="cross-row reverse-row" data-animate>
        <div class="visual-col">
          <div class="image-frame tilt-right">
            <img 
              src="/images/underwriting_boardroom.jpg" 
              alt="Underwriting and payment specialists collaborating on custom account configuration" 
              class="real-photo"
              loading="lazy"
              width="540"
              height="380"
            />
          </div>
        </div>

        <div class="text-col">
          <span class="phase-label text-indigo">TAILORED SETUP &amp; UNDERWRITING</span>
          <h3 class="row-title">
            We Pre-Underwrite Your Account &amp; Pre-Program Your Technology
          </h3>
          <p class="row-desc">
            No cookie-cutter setups. We match your business model with the right setup upfront—whether you need Smart POS terminals for retail, Tap to Pay on your phone, QuickBooks integration, or secure virtual terminals for invoices.
          </p>
          <div class="key-points">
            <div class="point-item">
              <span class="point-check check-indigo">✓</span>
              <span><strong>Program Flexibility:</strong> Choose Dual Pricing to offset processing fees or true Interchange-Plus.</span>
            </div>
            <div class="point-item">
              <span class="point-check check-indigo">✓</span>
              <span><strong>Pre-Configured:</strong> Your equipment arrives ready to accept payments out of the box.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Cross-Diagonal Intersecting Divider -->
      <div class="cross-slash-divider slash-left" aria-hidden="true">
        <span class="slash-line"></span>
      </div>

      <!-- Row 3: Image Left, Text Right -->
      <div class="cross-row" data-animate>
        <div class="visual-col">
          <div class="image-frame tilt-left">
            <img 
              src="/images/onboarded_image.jpg" 
              alt="Confident merchant operating with zero downtime and next-day funding" 
              class="real-photo"
              loading="lazy"
              width="540"
              height="380"
            />
          </div>
        </div>

        <div class="text-col">
          <span class="phase-label text-mint">ZERO-DOWNTIME GO LIVE</span>
          <h3 class="row-title">
            Go Live Seamlessly with Guaranteed Zero Payment Disruption
          </h3>
          <p class="row-desc">
            Your existing processor stays active until your new OneFunding account is verified and fully tested. Once ready, you start accepting payments immediately, with direct deposits landing in your business account the next business day.
          </p>
          <div class="key-points">
            <div class="point-item">
              <span class="point-check check-mint">✓</span>
              <span><strong>Zero Interruption:</strong> Your customers never notice a switch; transactions process without a pause.</span>
            </div>
            <div class="point-item">
              <span class="point-check check-mint">✓</span>
              <span><strong>Dedicated US Support:</strong> Direct line to a real human account manager whenever you need help.</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Simple, Clean CTA -->
    <div class="simple-onboarding-cta text-center">
      <a href={SITE_CONFIG.ctaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
        <span>Get Your Free Statement Review →</span>
      </a>
      <p class="cta-microtext">
        Zero obligation &bull; No long-term contracts &bull; 24–48h approvals
      </p>
    </div>

  </div>
</section>

<style>
  /* ==========================================================================
     OPEN-AIR CROSS-DIAGONAL ONBOARDING SECTION (HUMAN & NON-CARD LAYOUT)
     ========================================================================== */

  .how-it-works-diagonal-section {
    position: relative;
    padding: 7rem 0 6rem;
    background-color: var(--bg-page);
    overflow: hidden;
  }

  .relative-content {
    position: relative;
    z-index: 2;
  }

  /* Cross-Diagonal Graphic Lines */
  .cross-diagonal-lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .diag-line {
    position: absolute;
    width: 140%;
    left: -20%;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(203, 213, 225, 0.4) 50%, transparent 100%);
  }

  .diag-line-1 {
    top: 28%;
    transform: rotate(-3.5deg);
  }

  .diag-line-2 {
    top: 68%;
    transform: rotate(3.5deg);
  }

  /* Header Styles */
  .onboarding-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    background: #f1f5f9;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-heading);
    margin-bottom: 1rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--emerald-primary);
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.2);
  }

  .section-subtitle {
    max-width: 660px;
    margin: 0.75rem auto 4rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-body);
  }

  /* Cross-Diagonal Rows Container */
  .cross-diagonal-rows {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
    max-width: 1060px;
    margin: 0 auto;
  }

  /* Individual Row: Open-Air 2-Column Grid */
  .cross-row {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 4rem;
    align-items: center;
  }

  .reverse-row {
    grid-template-columns: 1.15fr 1fr;
  }

  .reverse-row .visual-col {
    order: 2;
  }

  .reverse-row .text-col {
    order: 1;
  }

  /* Visual Column & Image Frames */
  .visual-col {
    position: relative;
  }

  .image-frame {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 12px 32px -4px rgba(15, 23, 42, 0.08), 0 4px 12px -2px rgba(15, 23, 42, 0.04);
    border: 1px solid var(--border-light);
    background: #ffffff;
    transition: transform 0.4s ease;
  }

  .tilt-left {
    transform: perspective(1000px) rotateY(2deg) rotateX(1deg);
  }

  .tilt-right {
    transform: perspective(1000px) rotateY(-2deg) rotateX(1deg);
  }

  .image-frame:hover {
    transform: perspective(1000px) rotateY(0deg) rotateX(0deg) translateY(-2px);
  }

  .real-photo {
    width: 100%;
    height: 320px;
    object-fit: cover;
    display: block;
  }

  /* Floating Authentic Micro-Proof Pills */
  .floating-proof-pill {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.95rem;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: var(--radius-full);
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.08);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-heading);
    z-index: 2;
  }

  .pill-bottom-right {
    bottom: 1rem;
    right: 1rem;
  }

  .pill-bottom-left {
    bottom: 1rem;
    left: 1rem;
  }

  .proof-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .dot-indigo { background: var(--indigo-primary); }
  .dot-mint   { background: var(--mint-primary); }

  /* Text Column Styles */
  .phase-label {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .text-indigo { color: var(--indigo-primary); }
  .text-mint   { color: var(--mint-primary); }

  .row-title {
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-heading);
    margin-bottom: 1rem;
    letter-spacing: -0.015em;
  }

  .row-desc {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 1.5rem;
  }

  /* Key Points Checklist */
  .key-points {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .point-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text-body);
  }

  .point-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    font-size: 0.72rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .check-indigo {
    background: var(--indigo-bg);
    color: var(--indigo-primary);
  }

  .check-mint {
    background: var(--mint-bg);
    color: var(--mint-primary);
  }

  /* Cross-Diagonal Intersecting Dividers */
  .cross-slash-divider {
    position: relative;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .slash-line {
    width: 100%;
    height: 1.5px;
    background: linear-gradient(90deg, transparent 0%, rgba(79, 70, 229, 0.3) 30%, rgba(5, 150, 105, 0.3) 70%, transparent 100%);
  }

  .slash-right .slash-line {
    transform: rotate(-1.5deg);
  }

  .slash-left .slash-line {
    transform: rotate(1.5deg);
  }

  /* Simple CTA Section */
  .simple-onboarding-cta {
    margin-top: 5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .cta-microtext {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Responsive Behavior */
  @media (max-width: 900px) {
    .how-it-works-diagonal-section {
      padding: 4.5rem 0;
    }

    .cross-diagonal-rows {
      gap: 3.5rem;
    }

    .cross-row,
    .reverse-row {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .reverse-row .visual-col {
      order: 1;
    }

    .reverse-row .text-col {
      order: 2;
    }

    .tilt-left,
    .tilt-right {
      transform: none;
    }

    .real-photo {
      height: 250px;
    }

    .cross-slash-divider {
      display: none;
    }
  }
</style>

