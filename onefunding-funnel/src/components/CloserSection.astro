---
// CloserSection.astro - Clean Light-Theme Closer Section (Bottom Hero & Rate Analysis Hub)
import RateAnalysisForm from './RateAnalysisForm.astro';
---

<section class="section section-white closer-section" id="closer">
  <div class="container">
    <div class="section-header-clean closer-header">
      <h2>
        Stop Overpaying on Card Processing. <br />
        <span class="text-emerald">Protect Your Volume with OneFunding.</span>
      </h2>
      <p>
        Stop giving away 20% to 40% of your gross margin in arbitrary aggregator fees. Submit your details below to receive a custom Interchange-Plus savings report within 24 hours.
      </p>
    </div>

    <!-- Embedded High-Converting Lead Form -->
    <RateAnalysisForm />
  </div>
</section>

<style>
  .closer-section {
    padding-top: 4.5rem;
    padding-bottom: 5.5rem;
  }

  .closer-header {
    max-width: 760px;
    margin-bottom: 3rem;
  }

  .text-emerald {
    color: var(--emerald-primary);
  }
</style>
