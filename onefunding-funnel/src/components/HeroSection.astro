---
// HeroSection.astro - Clean Light Hero Section (5-Second Rule Compliant)
import { SITE_CONFIG } from '../config/site';
---

<section class="section section-white hero-section" id="hero">
  <div class="container">
    <div class="hero-grid">
      <!-- Left Column: Copy & Conversion Hierarchy -->
      <div class="hero-content">
        <!-- Headline: Human Scale, Punchy & Clear -->
        <h2 class="hero-title">
          Stop Funding Stripe's Growth. <br />
          <span class="text-blue">Keep More of Every Dollar</span> <span class="text-gold">Your Business Earns.</span>
        </h2>

        <!-- Subheadline -->
        <p class="hero-subtitle">
          OneFunding gives high-growth businesses <strong>Interchange-Plus wholesale rates</strong>, <strong>next-day cash deposits</strong>, and multi-gateway underwriting that <strong>never gets shut down</strong> — no matter your industry.
        </p>



        <!-- Primary CTA & FUD Reduction -->
        <div class="hero-cta-block">
          <a href={SITE_CONFIG.ctaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg hero-cta-btn">
            <span>GET MY FREE RATE ANALYSIS →</span>
          </a>

          <div class="fud-list">
            <div class="fud-item">
              <span class="fud-check">✓</span> No long-term contracts
            </div>
            <div class="fud-item">
              <span class="fud-check">✓</span> Zero setup fees
            </div>
            <div class="fud-item">
              <span class="fud-check">✓</span> 24–48h approvals
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Clean Dynamic Focal Image Stack -->
      <div class="hero-visual">
        <div class="focal-stage" id="heroFocalStage" aria-label="Interactive Merchant Payment Showcase">
          <!-- Image 1 -->
          <div class="focal-card card-0 is-active" data-index="0">
            <img src="/images/contactless_payment.jpg" alt="Contactless Smart POS Payment" loading="eager" />
          </div>

          <!-- Image 2 -->
          <div class="focal-card card-1 is-next" data-index="1">
            <img src="/images/man_paying.jpg" alt="Retail Customer Checkout" loading="eager" />
          </div>

          <!-- Image 3 -->
          <div class="focal-card card-2 is-prev" data-index="2">
            <img src="/images/sucess_hero image.jpg" alt="Merchant Business Scaling Success" loading="eager" />
          </div>
        </div>

        <!-- Focal Stage Indicators -->
        <div class="focal-indicators" id="heroFocalDots">
          <button class="focal-dot active" data-target="0" aria-label="Show slide 1"></button>
          <button class="focal-dot" data-target="1" aria-label="Show slide 2"></button>
          <button class="focal-dot" data-target="2" aria-label="Show slide 3"></button>
        </div>
        
        <!-- Social Proof Form 1: Verified Rating -->
        <div class="hero-social-proof-clean">
          <div class="rating-stars" aria-label="5 out of 5 stars">
            ★★★★★
          </div>
          <span class="proof-text">
            <strong>4.9/5 Rating</strong> · Trusted by <strong>2,000+ scaling merchants</strong>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 3.25rem;
    padding-bottom: 3.75rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-title {
    margin-bottom: 1.1rem;
  }

  .text-emerald {
    color: var(--emerald-primary);
  }

  .text-blue {
    color: #1d4ed8;
  }

  .text-gold {
    color: #d97706;
  }

  .hero-subtitle {
    font-size: 1.08rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    color: var(--text-body);
    max-width: 540px;
  }

  .hero-social-proof-clean {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.25rem;
    justify-content: flex-start;
  }

  .rating-stars {
    color: #f59e0b;
    font-size: 1rem;
    letter-spacing: 0.05em;
  }

  .proof-text {
    font-size: 0.86rem;
    color: var(--text-body);
  }

  .proof-text strong {
    color: var(--text-heading);
  }

  .hero-cta-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: fit-content;
    margin-top: 1.5rem;
  }

  .hero-cta-btn {
    letter-spacing: 0.02em;
  }

  .hero-cta-block .fud-list {
    justify-content: flex-start;
    margin-top: 0.75rem;
  }

  /* ==========================================================================
     DYNAMIC AUTO-ROTATING FOCAL IMAGE SHOWCASE
     ========================================================================== */
  .hero-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .focal-stage {
    position: relative;
    width: 100%;
    height: 380px;
    margin-bottom: 0.5rem;
    perspective: 1000px;
  }

  .focal-card {
    position: absolute;
    border-radius: 18px;
    overflow: hidden;
    cursor: pointer;
    background: #ffffff;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12);
    border: 3px solid #ffffff;
    transition: all 0.65s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform, opacity, z-index;
  }

  .focal-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .focal-caption {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    opacity: 0;
    transform: translateY(6px);
    transition: all 0.4s ease;
    pointer-events: none;
    letter-spacing: 0.02em;
  }

  /* Active Large Focal Slot (Front & Center) */
  .focal-card.is-active {
    width: 78%;
    height: 290px;
    top: 45px;
    left: 5%;
    z-index: 10;
    opacity: 1;
    transform: translate(0, 0) scale(1) rotate(0deg);
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.18), 0 0 0 1px rgba(5, 150, 105, 0.2);
  }

  .focal-card.is-active .focal-caption {
    opacity: 1;
    transform: translateY(0);
  }

  /* Next Preview Slot (Top Right Behind) */
  .focal-card.is-next {
    width: 56%;
    height: 210px;
    top: 0;
    right: 0;
    z-index: 5;
    opacity: 0.85;
    transform: translate(0, 0) scale(0.94) rotate(4deg);
    filter: brightness(0.92);
  }

  /* Previous Preview Slot (Bottom Right Behind) */
  .focal-card.is-prev {
    width: 52%;
    height: 190px;
    bottom: 0;
    right: 6%;
    z-index: 4;
    opacity: 0.75;
    transform: translate(0, 0) scale(0.88) rotate(-3deg);
    filter: brightness(0.85);
  }

  .focal-card:hover {
    box-shadow: 0 24px 48px rgba(15, 23, 42, 0.22);
  }

  .focal-card.is-next:hover,
  .focal-card.is-prev:hover {
    opacity: 1;
    filter: brightness(1);
    transform: scale(0.98);
    z-index: 8;
  }

  /* Indicators */
  .focal-indicators {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .focal-dot {
    width: 24px;
    height: 5px;
    border-radius: 999px;
    background: #cbd5e1;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .focal-dot.active {
    width: 40px;
    background: var(--emerald-primary);
  }

  @media (max-width: 992px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-content {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-subtitle {
      max-width: 100%;
    }

    .hero-cta-block {
      align-items: center;
      width: 100%;
    }

    .hero-cta-block .fud-list {
      justify-content: center;
    }

    .focal-stage {
      height: 340px;
    }

    .focal-card.is-active {
      width: 82%;
      height: 250px;
      left: 2%;
    }
  }
</style>

<script>
  // ===== Dynamic Auto-Rotating Hero Image Stage =====
  function initFocalCarousel() {
    const stage = document.getElementById('heroFocalStage');
    const cards = stage?.querySelectorAll<HTMLElement>('.focal-card');
    const dots = document.querySelectorAll<HTMLElement>('#heroFocalDots .focal-dot');

    if (!stage || !cards || cards.length < 3) return;

    let currentIndex = 0;
    let autoInterval: ReturnType<typeof setInterval> | null = null;
    const ROTATION_DELAY = 3200; // 3.2 seconds rotation

    const positions = ['is-active', 'is-next', 'is-prev'];

    function applyPositions(activeIdx: number) {
      cards.forEach((card, i) => {
        card.classList.remove('is-active', 'is-next', 'is-prev');
        // Relative position offset (0 = active, 1 = next, 2 = prev)
        const rel = (i - activeIdx + cards.length) % cards.length;
        card.classList.add(positions[rel]);
      });

      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === activeIdx);
      });
    }

    function nextSlide() {
      currentIndex = (currentIndex + 1) % cards.length;
      applyPositions(currentIndex);
    }

    function startAutoPlay() {
      if (autoInterval) clearInterval(autoInterval);
      autoInterval = setInterval(nextSlide, ROTATION_DELAY);
    }

    function stopAutoPlay() {
      if (autoInterval) {
        clearInterval(autoInterval);
        autoInterval = null;
      }
    }

    // Card Click: Bring clicked card to active large spot
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const targetIdx = parseInt(card.getAttribute('data-index') || '0', 10);
        currentIndex = targetIdx;
        applyPositions(currentIndex);
        startAutoPlay(); // Reset timer on manual click
      });
    });

    // Dot Click
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const targetIdx = parseInt(dot.getAttribute('data-target') || '0', 10);
        currentIndex = targetIdx;
        applyPositions(currentIndex);
        startAutoPlay();
      });
    });

    // Hover to Pause
    stage.addEventListener('mouseenter', stopAutoPlay);
    stage.addEventListener('mouseleave', startAutoPlay);

    // Initial Start
    applyPositions(0);
    startAutoPlay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFocalCarousel);
  } else {
    initFocalCarousel();
  }
</script>

