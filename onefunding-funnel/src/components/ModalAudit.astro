---
// ModalAudit.astro - Fast Action Popup Modal for Quick Rate Analysis (Light Theme)
---

<div class="modal-overlay" id="auditModal" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="modal-content">
    <button class="modal-close" id="modalCloseBtn" aria-label="Close modal">✕</button>
    
    <div class="modal-header text-center">
      <div class="badge-tag">
        <span class="pulse-dot-green"></span>
        <span>EXPRESS RATE AUDIT</span>
      </div>
      <h3 class="modal-title">Get Your Free 24h Rate Analysis</h3>
      <p class="modal-desc">Enter your volume details below to calculate your fee savings.</p>
    </div>

    <form class="modal-form" id="modalAuditForm">
      <div class="form-group">
        <label for="modalFullName" class="form-label">Full Name *</label>
        <input type="text" id="modalFullName" name="fullName" class="form-control" placeholder="Sarah Jenkins" required />
      </div>

      <div class="form-group">
        <label for="modalWorkEmail" class="form-label">Business Email *</label>
        <input type="email" id="modalWorkEmail" name="workEmail" class="form-control" placeholder="sarah@company.com" required />
      </div>

      <div class="form-group">
        <label for="modalPhone" class="form-label">Phone Number *</label>
        <input type="tel" id="modalPhone" name="phoneNumber" class="form-control" placeholder="(555) 000-0000" required />
      </div>

      <div class="form-group">
        <label for="modalVolume" class="form-label">Monthly Volume *</label>
        <select id="modalVolume" name="monthlyVolume" class="form-control" required>
          <option value="" disabled selected>Select Monthly Volume</option>
          <option value="10k-25k">$10,000 – $25,000 / mo</option>
          <option value="25k-50k">$25,000 – $50,000 / mo</option>
          <option value="50k-100k">$50,000 – $100,000 / mo</option>
          <option value="100k-250k">$100,000 – $250,000 / mo</option>
          <option value="250k-500k">$250,000 – $500,000 / mo</option>
          <option value="500k-plus">$500,000+ / mo (Enterprise)</option>
        </select>
      </div>

      <button type="submit" class="btn btn-primary btn-full modal-submit-btn">
        <span>GET FREE RATE REPORT →</span>
      </button>

      <div class="fud-list modal-fud">
        <div class="fud-item"><span class="fud-check">✓</span> 100% Confidential</div>
        <div class="fud-item"><span class="fud-check">✓</span> Zero Obligation</div>
      </div>
    </form>
  </div>
</div>

<style>
  .modal-header {
    margin-bottom: 1.25rem;
  }

  .modal-title {
    font-size: 1.4rem;
    color: var(--text-heading);
    margin-top: 0.4rem;
    margin-bottom: 0.2rem;
  }

  .modal-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .modal-submit-btn {
    margin-top: 0.75rem;
    padding: 0.9rem;
  }

  .modal-fud {
    font-size: 0.76rem;
    margin-top: 0.75rem;
  }
</style>

<script>
  function initModal() {
    const modal = document.getElementById('auditModal');
    const closeBtn = document.getElementById('modalCloseBtn');
    const modalForm = document.getElementById('modalAuditForm');

    function openModal() {
      if (modal) {
        modal.classList.add('active');
        modal.setAttribute('aria-hidden', 'false');
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.remove('active');
        modal.setAttribute('aria-hidden', 'true');
      }
    }

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    document.querySelectorAll('[data-open-modal]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    if (modalForm) {
      modalForm.addEventListener('submit', (e) => {
        e.preventDefault();
        alert('Thank you! Your rate audit request has been sent. A specialist will reach out shortly.');
        closeModal();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModal);
  } else {
    initModal();
  }
</script>
