---
// ProblemSection.astro - Two-Column: Animated Pain Points (Left) + Live Rate Calculator (Right)
---

<section class="section section-white problem-section" id="problem">
  <div class="container">

    <!-- Section Header -->
    <div class="section-header-clean">
      <h2>
        Here's What Staying on Flat-Rate Pricing Actually Costs You
      </h2>
      <p>
        Every month you stay on Stripe or Square, an invisible tax drains your margin. Drag the slider to see exactly how much you're losing — right now.
      </p>
    </div>

    <!-- 2-Column Layout: Problems Left, Calculator Right -->
    <div class="problem-calculator-grid">

      <!-- LEFT: Animated Pain Points -->
      <div class="pain-col">

        <!-- Pain Item 1 -->
        <div class="pain-item" data-animate>
          <div class="pain-number">01</div>
          <div class="pain-body">
            <h3 class="pain-title">Rolling Reserve Holds: 90–180 Days</h3>
            <div class="pain-fade-box">
              <p class="pain-desc">
                A sudden spike in sales triggers automated aggregator fraud flags without warning. Your hard-earned revenue gets locked in a rolling holding account for up to 6 months—choking inventory reorders, marketing ad spend, and payroll right when you need cash most.
              </p>
              <button type="button" class="pain-toggle-btn" aria-expanded="false">
                <span class="btn-text">Show full detail</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="toggle-icon">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div class="pain-divider"></div>

        <!-- Pain Item 2 -->
        <div class="pain-item" data-animate>
          <div class="pain-number">02</div>
          <div class="pain-body">
            <h3 class="pain-title">Padded Flat-Rate Markups</h3>
            <div class="pain-fade-box">
              <p class="pain-desc">
                A flat 2.9%–3.5% fee looks simple on paper until you calculate the actual wholesale cost. Aggregators quietly pocket the large margin between true wholesale interchange (~1.4%) and the flat rate they bill you on every card transaction.
              </p>
              <button type="button" class="pain-toggle-btn" aria-expanded="false">
                <span class="btn-text">Show full detail</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="toggle-icon">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div class="pain-divider"></div>

        <!-- Pain Item 3 -->
        <div class="pain-item" data-animate>
          <div class="pain-number">03</div>
          <div class="pain-body">
            <h3 class="pain-title">Surprise Account Terminations</h3>
            <div class="pain-fade-box">
              <p class="pain-desc">
                Scaling, subscription, and specialized brands get re-categorized as "high-risk" without notice. Automated risk algorithms freeze processing overnight—leaving businesses with dead checkout pages, canned bot emails, and zero live human recourse.
              </p>
              <button type="button" class="pain-toggle-btn" aria-expanded="false">
                <span class="btn-text">Show full detail</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="toggle-icon">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div class="pain-divider"></div>

        <!-- Pain Item 4 -->
        <div class="pain-item" data-animate>
          <div class="pain-number">04</div>
          <div class="pain-body">
            <h3 class="pain-title">Multi-Day Settlement Lags</h3>
            <div class="pain-fade-box">
              <p class="pain-desc">
                Traditional aggregators delay settlement for days while holding your funds to generate float interest. Multi-day payout delays prevent you from reinvesting daily revenue into ad campaigns, bulk inventory discounts, and immediate business expansion.
              </p>
              <button type="button" class="pain-toggle-btn" aria-expanded="false">
                <span class="btn-text">Show full detail</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="toggle-icon">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </div>
          </div>
        </div>

      </div>

      <!-- RIGHT: Live Rate Calculator Card -->
      <div class="calc-col">
        <div class="calc-sticky-wrap">
          <div class="calc-card" id="rateCalculator">

            <div class="calc-header">
              <div class="calc-badge">
                <span class="pulse-dot-green"></span>
                <span>LIVE SAVINGS CALCULATOR</span>
              </div>
              <h3 class="calc-title">How Much Are You Overpaying Right Now?</h3>
              <p class="calc-desc">Drag the slider to your monthly volume and see the numbers update instantly.</p>
            </div>

            <!-- Slider -->
            <div class="calc-slider-section">
              <div class="volume-readout">
                <span class="readout-label">Your Monthly Volume</span>
                <span class="readout-val" id="volumeDisplay">$50,000</span>
              </div>
              <div class="slider-track-wrap">
                <input
                  type="range"
                  id="volumeSlider"
                  min="10000"
                  max="500000"
                  step="5000"
                  value="50000"
                  class="volume-slider-input"
                  aria-label="Monthly Processing Volume Slider"
                />
                <div class="slider-markers">
                  <span class="marker" data-val="10000" style="left: 0%;">$10K</span>
                  <span class="marker" data-val="100000" style="left: 18.4%; transform: translateX(-50%);">$100K</span>
                  <span class="marker" data-val="250000" style="left: 49%; transform: translateX(-50%);">$250K</span>
                  <span class="marker" data-val="500000" style="left: 100%; transform: translateX(-100%);">$500K+</span>
                </div>
              </div>
            </div>

            <!-- Comparison Columns -->
            <div class="calc-comparison-grid">
              <div class="calc-box box-traditional">
                <div class="box-tag text-amber">FLAT RATE (3.5%)</div>
                <div class="box-num text-dark" id="flatFeeDisplay">$1,750 / mo</div>
                <div class="box-sub" id="flatAnnualDisplay">$21,000 / year in fees</div>
              </div>
              <div class="calc-box box-onefunding">
                <div class="box-tag text-emerald">ONEFUNDING (Interchange+)</div>
                <div class="box-num text-emerald" id="onefundingFeeDisplay">$1,050 / mo</div>
                <div class="box-sub" id="onefundingAnnualDisplay">$12,600 / year in fees</div>
              </div>
            </div>

            <!-- Net Savings Strip -->
            <div class="net-savings-strip">
              <div class="savings-text-col">
                <span class="strip-label">YOUR ESTIMATED ANNUAL SAVINGS</span>
                <span class="strip-amount" id="netSavingsDisplay">$8,400 / year</span>
                <span class="strip-desc">Plus next-day settlement & multi-gateway uptime protection.</span>
              </div>
            </div>

            <!-- CTA -->
            <a href="#auditForm" class="btn btn-primary btn-full calc-cta-btn">
              <span>Claim These Rates — Free Audit →</span>
            </a>

            <div class="calc-trust-row">
              <span>✓ No obligation</span>
              <span>✓ 24h report</span>
              <span>✓ 100% confidential</span>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ===== Two-Column Grid ===== */
  .problem-calculator-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3.5rem;
    align-items: start;
  }

  /* ===== LEFT: Pain Items ===== */
  .pain-col {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .pain-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.75rem 0;
    opacity: 0;
    transform: translateX(-24px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }

  .pain-item.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  .pain-number {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    color: #959504ff;
    opacity: 0.5;
    letter-spacing: -0.03em;
    flex-shrink: 0;
    width: 48px;
    padding-top: 3px;
    user-select: none;
  }

  .pain-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .pain-title {
    font-size: 1.15rem;
    color: var(--text-heading);
    font-weight: 700;
    line-height: 1.35;
  }

  .pain-fade-box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    width: 100%;
    cursor: pointer;
  }

  .pain-desc {
    font-size: 0.93rem;
    color: var(--text-body);
    line-height: 1.65;
    max-height: 3.3em; /* Exactly ~2 lines */
    overflow: hidden;
    position: relative;
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 50%, rgba(0, 0, 0, 0) 100%);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 50%, rgba(0, 0, 0, 0) 100%);
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1), -webkit-mask-image 0.25s ease, mask-image 0.25s ease;
  }

  .pain-fade-box.is-expanded .pain-desc {
    max-height: 250px;
    -webkit-mask-image: none;
    mask-image: none;
  }

  .pain-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: none;
    padding: 0.15rem 0;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--emerald-primary);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .pain-toggle-btn:hover {
    color: var(--emerald-hover);
  }

  .toggle-icon {
    transition: transform 0.25s ease;
  }

  .pain-fade-box.is-expanded .toggle-icon {
    transform: rotate(180deg);
  }

  .text-amber { color: #b45309; }
  .text-indigo { color: #4338ca; }
  .text-dark { color: #0f172a; }

  .pain-divider {
    height: 1px;
    background: var(--border-light);
    margin: 0;
  }

  /* ===== RIGHT: Calculator Card ===== */
  .calc-col {
    position: relative;
  }

  .calc-sticky-wrap {
    position: sticky;
    top: 100px;
  }

  .calc-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: 2rem;
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .calc-header {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .calc-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.8rem;
    background: var(--emerald-bg);
    border: 1px solid var(--emerald-border);
    border-radius: var(--radius-full);
    color: var(--emerald-primary);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    width: fit-content;
  }

  .calc-title {
    font-size: 1.2rem;
    color: var(--text-heading);
    font-weight: 700;
    line-height: 1.3;
  }

  .calc-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  /* Slider */
  .volume-readout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
  }

  .readout-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .readout-val {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-heading);
    transition: color 0.2s ease;
  }

  .slider-track-wrap {
    padding: 0 0.15rem;
  }

  .volume-slider-input {
    -webkit-appearance: none;
    width: 100%;
    height: 8px;
    border-radius: 4px;
    background: linear-gradient(to right, var(--emerald-primary) 10%, #e2e8f0 10%);
    outline: none;
    cursor: pointer;
    transition: background 0.1s ease;
  }

  .volume-slider-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--emerald-primary);
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(5, 150, 105, 0.45);
    border: 2px solid #ffffff;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .volume-slider-input::-webkit-slider-thumb:hover,
  .volume-slider-input:active::-webkit-slider-thumb {
    transform: scale(1.2);
    box-shadow: 0 4px 14px rgba(5, 150, 105, 0.55);
  }

  .slider-markers {
    position: relative;
    width: 100%;
    height: 18px;
    margin-top: 0.65rem;
  }

  .slider-markers .marker {
    position: absolute;
    top: 0;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s ease;
    white-space: nowrap;
    user-select: none;
  }

  .slider-markers .marker:hover {
    color: var(--emerald-primary);
  }

  /* Comparison Grid */
  .calc-comparison-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .calc-box {
    padding: 1.15rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border: 1px solid var(--border-light);
  }

  .box-traditional {
    background: var(--bg-subtle);
  }

  .box-onefunding {
    background: var(--emerald-bg);
    border-color: var(--emerald-border);
  }

  .box-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .box-num {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
  }

  .box-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Net Savings Strip */
  .net-savings-strip {
    background: #0f172a;
    border-radius: var(--radius-md);
    padding: 1.25rem;
    color: #ffffff;
  }

  .savings-text-col {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .strip-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #94a3b8;
  }

  .strip-amount {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    color: #34d399;
  }

  .strip-desc {
    font-size: 0.78rem;
    color: #cbd5e1;
  }

  /* CTA */
  .calc-cta-btn {
    width: 100%;
    justify-content: center;
  }

  .calc-trust-row {
    display: flex;
    justify-content: space-around;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 1024px) {
    .problem-calculator-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .calc-sticky-wrap {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .calc-comparison-grid {
      grid-template-columns: 1fr;
    }

    .pain-number {
      font-size: 2rem;
      width: 38px;
    }
  }
</style>

<script>
  // ===== Pain Item Scroll Animations =====
  function initPainAnimations() {
    const items = document.querySelectorAll('[data-animate]');
    if (!items.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            const index = Array.from(items).indexOf(entry.target);
            setTimeout(() => {
              entry.target.classList.add('is-visible');
            }, index * 120);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    items.forEach((item) => observer.observe(item));
  }

  // ===== Pain Item Expand/Collapse Toggle =====
  function initPainToggles() {
    const toggleBtns = document.querySelectorAll('.pain-toggle-btn');
    toggleBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const box = btn.closest('.pain-fade-box');
        if (!box) return;
        const btnText = btn.querySelector('.btn-text');
        const isExpanded = box.classList.toggle('is-expanded');

        btn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
        if (btnText) {
          btnText.textContent = isExpanded ? 'Show less' : 'Show full detail';
        }
      });
    });

    const fadeBoxes = document.querySelectorAll('.pain-fade-box');
    fadeBoxes.forEach((box) => {
      box.addEventListener('click', () => {
        if (!box.classList.contains('is-expanded')) {
          box.classList.add('is-expanded');
          const btn = box.querySelector('.pain-toggle-btn');
          const btnText = box.querySelector('.btn-text');
          if (btn) btn.setAttribute('aria-expanded', 'true');
          if (btnText) btnText.textContent = 'Show less';
        }
      });
    });
  }

  // ===== Live Rate Calculator =====
  function initCalculator() {
    const slider = document.getElementById('volumeSlider') as HTMLInputElement;
    const volDisplay = document.getElementById('volumeDisplay');
    const flatFeeDisplay = document.getElementById('flatFeeDisplay');
    const flatAnnualDisplay = document.getElementById('flatAnnualDisplay');
    const onefundingFeeDisplay = document.getElementById('onefundingFeeDisplay');
    const onefundingAnnualDisplay = document.getElementById('onefundingAnnualDisplay');
    const netSavingsDisplay = document.getElementById('netSavingsDisplay');
    const markers = document.querySelectorAll<HTMLElement>('.slider-markers .marker');

    if (!slider || !volDisplay) return;

    function updateSliderGradient(val: number, min: number, max: number) {
      const pct = ((val - min) / (max - min)) * 100;
      slider.style.background = `linear-gradient(to right, #059669 0%, #059669 ${pct}%, #e2e8f0 ${pct}%, #e2e8f0 100%)`;
    }

    function update() {
      const volume = parseFloat(slider.value);
      volDisplay!.textContent = '$' + volume.toLocaleString('en-US');
      updateSliderGradient(volume, 10000, 500000);

      // Traditional 3.5% effective rate
      const flatMonthly = volume * 0.035;
      const flatAnnual = flatMonthly * 12;

      // OneFunding Interchange-Plus estimated effective ~2.1%
      const onefundingMonthly = volume * 0.021;
      const onefundingAnnual = onefundingMonthly * 12;

      const netAnnualSavings = flatAnnual - onefundingAnnual;

      flatFeeDisplay!.textContent = '$' + Math.round(flatMonthly).toLocaleString('en-US') + ' / mo';
      flatAnnualDisplay!.textContent = '$' + Math.round(flatAnnual).toLocaleString('en-US') + ' / year in fees';

      onefundingFeeDisplay!.textContent = '$' + Math.round(onefundingMonthly).toLocaleString('en-US') + ' / mo';
      onefundingAnnualDisplay!.textContent = '$' + Math.round(onefundingAnnual).toLocaleString('en-US') + ' / year in fees';

      netSavingsDisplay!.textContent = '$' + Math.round(netAnnualSavings).toLocaleString('en-US') + ' / year';
    }

    slider.addEventListener('input', update);

    // Clicking any marker snaps the slider to that exact amount
    markers.forEach((marker) => {
      marker.addEventListener('click', () => {
        const targetVal = marker.getAttribute('data-val');
        if (targetVal) {
          slider.value = targetVal;
          update();
        }
      });
    });

    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initPainAnimations();
      initPainToggles();
      initCalculator();
    });
  } else {
    initPainAnimations();
    initPainToggles();
    initCalculator();
  }
</script>
