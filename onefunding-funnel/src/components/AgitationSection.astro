---
// AgitationSection.astro - Open-Air Staircase Layout (Refined Palette, Centered CTA)
import { SITE_CONFIG } from '../config/site';
---

<section class="section section-subtle agitation-section" id="agitation">
  <div class="container">

    <div class="section-header-clean">
      <h2>
        Every Day You Wait, This Is What It's Costing You
      </h2>
      <p>
        The aggregator model was built to protect their risk, not your margins. These aren't estimates — they're the mathematical reality of flat-rate pricing at scale.
      </p>
    </div>

    <!-- ===== OPEN-AIR STAIRCASE LAYOUT ===== -->
    <div class="staircase-flow">

      <!-- Step 1: Immediate Loss -->
      <div class="staircase-step step-tier-1" data-metric>
        <div class="step-metric-block">
          <span class="agit-tag tag-amber">ANNUAL FEE OVERPAYMENT</span>
          <div class="agit-big-num text-dark">
            $<span class="count-up" data-target="22000" data-format="currency">0</span>
          </div>
        </div>

        <div class="step-content-block">
          <h3 class="agit-heading">Overpaid in Flat-Rate Markups</h3>
          <p class="agit-copy">
            Aggregators pocket the spread between ~1.4% wholesale interchange and the 3.5% they charge you — silently, on every single transaction. The more you grow, the more you lose.
          </p>
        </div>
      </div>

      <!-- Step 2: Systemic Risk -->
      <div class="staircase-step step-tier-2" data-metric>
        <div class="step-metric-block">
          <span class="agit-tag tag-indigo">ACCOUNT FREEZE RISK</span>
          <div class="agit-big-num text-dark">
            <span class="count-up" data-target="25" data-format="percent">0</span>
          </div>
        </div>

        <div class="step-content-block">
          <h3 class="agit-heading">Scaling Accounts Capped or Frozen</h3>
          <p class="agit-copy">
            Automated AI risk bots — not humans — decide your fate. A sudden sales spike or one chargeback cluster triggers instant volume caps with zero consultation, zero warning, zero recourse.
          </p>
        </div>
      </div>

      <!-- Step 3: Growth Bottleneck -->
      <div class="staircase-step step-tier-3" data-metric>
        <div class="step-metric-block">
          <span class="agit-tag tag-slate">CASH FLOW DRAG</span>
          <div class="agit-big-num text-dark">
            <span class="count-up" data-target="14" data-format="days">0</span>
          </div>
        </div>

        <div class="step-content-block">
          <h3 class="agit-heading">Delayed Access to Your Working Capital</h3>
          <p class="agit-copy">
            Multi-day settlement lags lock your earned revenue away — preventing you from reinvesting into ads, inventory, and growth opportunities your competitors are capturing right now instead of you.
          </p>
        </div>
      </div>

    </div>

    <!-- Centered CTA Button -->
    <div class="agitation-cta-row">
      <a href={SITE_CONFIG.ctaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
        <span>Stop the Bleeding — Get My Free Rate Report →</span>
      </a>
    </div>

  </div>
</section>

<style>
  .agitation-section {
    position: relative;
  }

  /* ===== OPEN-AIR STAIRCASE CONTAINER ===== */
  .staircase-flow {
    max-width: 920px;
    margin: 0 auto 2.75rem auto;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* ===== OPEN-AIR STEP (NO CARDS, NO BORDERS, NO BOX-SHADOWS) ===== */
  .staircase-step {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2.5rem;
    align-items: center;
    padding: 0;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }

  .staircase-step.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Cascading Staircase Indentations (Desktop) */
  @media (min-width: 960px) {
    .step-tier-1 {
      margin-left: 0;
      max-width: 760px;
    }

    .step-tier-2 {
      margin-left: 4.5rem;
      max-width: 760px;
    }

    .step-tier-3 {
      margin-left: 9rem;
      max-width: 760px;
    }
  }

  @media (min-width: 768px) and (max-width: 959px) {
    .step-tier-1 {
      margin-left: 0;
    }

    .step-tier-2 {
      margin-left: 2.5rem;
    }

    .step-tier-3 {
      margin-left: 5rem;
    }
  }

  /* Metric Column */
  .step-metric-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    align-items: flex-start;
  }

  /* Tags (Catchy titles placed above the numbers) */
  .agit-tag {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.22rem 0.6rem;
    border-radius: var(--radius-sm);
    width: fit-content;
    text-transform: uppercase;
  }

  .tag-amber {
    background: #fffbeb;
    color: #b45309;
    border: 1px solid #fef3c7;
  }

  .tag-indigo {
    background: #eef2ff;
    color: #4338ca;
    border: 1px solid #e0e7ff;
  }

  .tag-slate {
    background: #ead9ccff;
    color: #b57e20ff;
    border: 1px solid #e9c4a9ff;
  }

  /* Big Number (Premium Deep Navy Slate) */
  .agit-big-num {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .text-dark {
    color: #0f172a;
  }

  /* Content Column */
  .step-content-block {
    display: flex;
    flex-direction: column;
  }

  .agit-heading {
    font-size: 1.25rem;
    color: var(--text-heading);
    font-weight: 700;
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }

  .agit-copy {
    font-size: 0.95rem;
    color: var(--text-body);
    line-height: 1.65;
  }

  /* ===== CENTERED CTA ===== */
  .agitation-cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1.5rem auto 0 auto;
    text-align: center;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .staircase-flow {
      gap: 2rem;
    }

    .staircase-step {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      padding: 0;
      margin-left: 0 !important;
      max-width: 100% !important;
    }

    .agit-big-num {
      font-size: 2.4rem;
    }

    .agitation-cta-row .btn {
      width: 100%;
    }
  }
</style>

<script>
  function initAgitation() {
    const steps = document.querySelectorAll('[data-metric]');

    function easeOutQuart(t: number): number {
      return 1 - Math.pow(1 - t, 4);
    }

    function animateCountUp(el: Element) {
      const spanEl = el.querySelector('.count-up') as HTMLElement;
      if (!spanEl) return;

      const target = parseFloat(spanEl.dataset.target || '0');
      const format = spanEl.dataset.format || 'number';
      const duration = 1400;
      const startTime = performance.now();

      function formatValue(val: number): string {
        if (format === 'currency') return Math.round(val).toLocaleString('en-US');
        if (format === 'percent') return Math.round(val) + '%';
        if (format === 'days')    return Math.round(val) + ' Days';
        return Math.round(val).toLocaleString('en-US');
      }

      function tick(now: number) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        spanEl.textContent = formatValue(easeOutQuart(progress) * target);
        if (progress < 1) requestAnimationFrame(tick);
        else spanEl.textContent = formatValue(target);
      }

      requestAnimationFrame(tick);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const index = Array.from(steps).indexOf(entry.target);
            setTimeout(() => {
              entry.target.classList.add('is-visible');
              animateCountUp(entry.target);
            }, index * 160);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );

    steps.forEach((s) => observer.observe(s));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAgitation);
  } else {
    initAgitation();
  }
</script>
