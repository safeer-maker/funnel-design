---
// AgitationSection.astro - Vertical Open-Air Steps (No Cards)
---

<section class="section section-subtle agitation-section" id="agitation">
  <div class="container">

    <div class="section-header-clean">
      <h2>
        Every Day You Wait, This Is What It's Costing You
      </h2>
      <p>
        The aggregator model was built to protect their risk, not your margins. These aren't estimates — they're the mathematical reality of flat-rate pricing at scale.
      </p>
    </div>

    <!-- ===== VERTICAL STEPS ===== -->
    <div class="agitation-steps">

      <!-- Step 1 -->
      <div class="agit-step" data-metric>
        <div class="agit-step-left">
          <div class="agit-number-wrap">
            <div class="agit-big-num text-rose">
              $<span class="count-up" data-target="22000" data-format="currency">0</span>
            </div>
            <div class="agit-tag tag-rose">ANNUAL FEE OVERPAYMENT</div>
          </div>

          <!-- Bar visual -->
          <div class="agit-visual">
            <div class="metric-bar-bg">
              <div class="metric-bar-fill bar-rose" style="width: 0%" data-target-width="78%"></div>
            </div>
            <div class="metric-bar-labels">
              <span>You pay: 3.5%</span>
              <span>True cost: ~1.4%</span>
            </div>
          </div>
        </div>

        <div class="agit-step-divider"></div>

        <div class="agit-step-right">
          <h3 class="agit-heading">Overpaid in Flat-Rate Markups</h3>
          <p class="agit-copy">
            Aggregators pocket the spread between ~1.4% wholesale interchange and the 3.5% they charge you — silently, on every single transaction. The more you grow, the more you lose.
          </p>
        </div>
      </div>

      <div class="step-separator" aria-hidden="true"></div>

      <!-- Step 2 -->
      <div class="agit-step" data-metric>
        <div class="agit-step-left">
          <div class="agit-number-wrap">
            <div class="agit-big-num text-rose">
              <span class="count-up" data-target="25" data-format="percent">0</span>
            </div>
            <div class="agit-tag tag-rose">ACCOUNT FREEZE RISK</div>
          </div>

          <!-- Frozen dot grid -->
          <div class="agit-visual">
            <div class="frozen-grid">
              <span class="frozen-dot dot-red" title="Frozen account"></span>
              <span class="frozen-dot dot-gray"></span>
              <span class="frozen-dot dot-gray"></span>
              <span class="frozen-dot dot-gray"></span>
            </div>
            <span class="frozen-caption">1 in every 4 scaling merchants</span>
          </div>
        </div>

        <div class="agit-step-divider"></div>

        <div class="agit-step-right">
          <h3 class="agit-heading">Scaling Accounts Capped or Frozen</h3>
          <p class="agit-copy">
            Automated AI risk bots — not humans — decide your fate. A sudden sales spike or one chargeback cluster triggers instant volume caps with zero consultation, zero warning, zero recourse.
          </p>
        </div>
      </div>

      <div class="step-separator" aria-hidden="true"></div>

      <!-- Step 3 -->
      <div class="agit-step" data-metric>
        <div class="agit-step-left">
          <div class="agit-number-wrap">
            <div class="agit-big-num text-rose">
              <span class="count-up" data-target="14" data-format="days">0</span>
            </div>
            <div class="agit-tag tag-rose">CASH FLOW DRAG</div>
          </div>

          <!-- Days track -->
          <div class="agit-visual">
            <div class="days-track">
              <div class="day-block day-locked"></div>
              <div class="day-block day-locked"></div>
              <div class="day-block day-locked"></div>
              <div class="day-block day-locked"></div>
              <div class="day-block day-locked"></div>
              <div class="day-block day-locked"></div>
              <div class="day-block day-locked"></div>
              <div class="day-block day-locked"></div>
              <div class="day-block day-locked"></div>
              <div class="day-block day-locked"></div>
              <div class="day-block day-locked"></div>
              <div class="day-block day-locked"></div>
              <div class="day-block day-locked"></div>
              <div class="day-block day-locked"></div>
              <div class="day-block day-free"></div>
            </div>
            <div class="days-legend">
              <span><span class="legend-dot dot-red-sm"></span> Locked 14 days by aggregator</span>
              <span><span class="legend-dot dot-green-sm"></span> OneFunding: next business day</span>
            </div>
          </div>
        </div>

        <div class="agit-step-divider"></div>

        <div class="agit-step-right">
          <h3 class="agit-heading">Delayed Access to Your Working Capital</h3>
          <p class="agit-copy">
            Multi-day settlement lags lock your earned revenue away — preventing you from reinvesting into ads, inventory, and growth opportunities your competitors are capturing right now instead of you.
          </p>
        </div>
      </div>

    </div>

    <!-- CTA -->
    <div class="agitation-cta-row">
      <p class="agitation-cta-text">Every day on flat-rate pricing is cash flowing out of your business into aggregator profits.</p>
      <a href="#auditForm" class="btn btn-primary btn-lg">
        <span>Stop the Bleeding — Get My Free Rate Report →</span>
      </a>
    </div>

  </div>
</section>

<style>
  /* ===== VERTICAL STEPS LAYOUT ===== */
  .agitation-steps {
    max-width: 860px;
    margin: 0 auto 3.5rem auto;
    display: flex;
    flex-direction: column;
  }

  /* Each step: big number left | divider | text right */
  .agit-step {
    display: grid;
    grid-template-columns: 220px 1px 1fr;
    gap: 2.5rem;
    align-items: center;
    padding: 2.5rem 0;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .agit-step.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Left column */
  .agit-step-left {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .agit-number-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .agit-big-num {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .text-rose { color: var(--rose-primary); }

  .agit-tag {
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    padding: 0.18rem 0.5rem;
    border-radius: var(--radius-sm);
    width: fit-content;
  }

  .tag-rose {
    background: var(--rose-bg);
    border: 1px solid var(--rose-border);
    color: var(--rose-primary);
  }

  /* Vertical pipe divider */
  .agit-step-divider {
    width: 1px;
    align-self: stretch;
    background: var(--border-light);
  }

  /* Right column */
  .agit-step-right {
    padding-left: 0.5rem;
  }

  .agit-heading {
    font-size: 1.2rem;
    color: var(--text-heading);
    font-weight: 700;
    margin-bottom: 0.55rem;
    line-height: 1.3;
  }

  .agit-copy {
    font-size: 0.95rem;
    color: var(--text-body);
    line-height: 1.68;
  }

  /* Separator between steps */
  .step-separator {
    height: 1px;
    background: var(--border-light);
    margin: 0;
  }

  /* ===== MINI VISUALIZATIONS ===== */
  .agit-visual {
    width: 100%;
  }

  /* Bar */
  .metric-bar-bg {
    height: 7px;
    background: var(--rose-bg);
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--rose-border);
    margin-bottom: 0.35rem;
  }

  .metric-bar-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .bar-rose { background: var(--rose-primary); }

  .metric-bar-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  /* Frozen dots */
  .frozen-grid {
    display: flex;
    gap: 0.45rem;
    margin-bottom: 0.35rem;
  }

  .frozen-dot {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .dot-red {
    background: #fecdd3;
    border: 2px solid var(--rose-primary);
    position: relative;
  }

  .dot-red::after {
    content: '✕';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 0.65rem;
    font-weight: 900;
    color: var(--rose-primary);
  }

  .dot-gray {
    background: var(--bg-muted);
    border: 1px solid var(--border-light);
  }

  .frozen-caption {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    display: block;
  }

  /* Days track */
  .days-track {
    display: flex;
    gap: 2px;
    margin-bottom: 0.45rem;
  }

  .day-block {
    flex: 1;
    height: 10px;
    border-radius: 2px;
  }

  .day-locked { background: #fecdd3; border: 1px solid #fda4af; }
  .day-free   { background: var(--emerald-primary); }

  .days-legend {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .days-legend span {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.69rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .legend-dot {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .dot-red-sm   { background: #fecdd3; border: 1px solid #fda4af; }
  .dot-green-sm { background: var(--emerald-primary); }

  /* ===== BOTTOM CTA ===== */
  .agitation-cta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 860px;
    margin: 0 auto;
    padding: 2rem 2.5rem;
    background: var(--bg-dark);
    border-radius: var(--radius-xl);
    flex-wrap: wrap;
  }

  .agitation-cta-text {
    font-size: 1rem;
    font-weight: 600;
    color: #cbd5e1;
    max-width: 460px;
    line-height: 1.55;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 720px) {
    .agit-step {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 2rem 0;
    }

    .agit-step-divider {
      display: none;
    }

    .agit-step-right {
      padding-left: 0;
    }

    .agit-big-num {
      font-size: 2.2rem;
    }

    .agitation-cta-row {
      flex-direction: column;
      text-align: center;
      padding: 1.75rem;
    }

    .agitation-cta-row .btn {
      width: 100%;
    }
  }
</style>

<script>
  function initAgitation() {
    const steps = document.querySelectorAll('[data-metric]');

    function easeOutQuart(t: number): number {
      return 1 - Math.pow(1 - t, 4);
    }

    function animateCountUp(el: Element) {
      const spanEl = el.querySelector('.count-up') as HTMLElement;
      if (!spanEl) return;

      const target = parseFloat(spanEl.dataset.target || '0');
      const format = spanEl.dataset.format || 'number';
      const duration = 1400;
      const startTime = performance.now();

      function formatValue(val: number): string {
        if (format === 'currency') return Math.round(val).toLocaleString('en-US');
        if (format === 'percent') return Math.round(val) + '%';
        if (format === 'days')    return Math.round(val) + ' Days';
        return Math.round(val).toLocaleString('en-US');
      }

      function tick(now: number) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        spanEl.textContent = formatValue(easeOutQuart(progress) * target);
        if (progress < 1) requestAnimationFrame(tick);
        else spanEl.textContent = formatValue(target);
      }

      requestAnimationFrame(tick);

      // Animate bar if present
      const bar = el.querySelector('.metric-bar-fill') as HTMLElement;
      if (bar) {
        setTimeout(() => { bar.style.width = bar.dataset.targetWidth || '0%'; }, 150);
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const index = Array.from(steps).indexOf(entry.target);
            setTimeout(() => {
              entry.target.classList.add('is-visible');
              animateCountUp(entry.target);
            }, index * 160);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );

    steps.forEach((s) => observer.observe(s));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAgitation);
  } else {
    initAgitation();
  }
</script>
