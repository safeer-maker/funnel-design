---
// Footer.astro - Compliance Disclaimer, Trust Badges, and Global Navigation
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-main-grid">
      <!-- Col 1: Brand & Contact -->
      <div class="footer-brand-col">
        <div class="footer-logo">
          <div class="logo-icon-small">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#059669" stroke-width="2.4">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <span class="brand-text">ONEFUNDING LLC</span>
        </div>
        <p class="footer-tagline">
          Enterprise payment orchestration, high-risk underwriting, and Interchange-Plus pricing for scaling merchants.
        </p>
        <div class="footer-contact-details">
          <div>📞 <strong>(800) 555-0199</strong> (24/7 Dedicated Support)</div>
          <div>✉️ <strong>rates@onefundingllc.com</strong></div>
        </div>
      </div>

      <!-- Col 2: Solutions -->
      <div class="footer-col">
        <h4 class="footer-col-title">Solutions</h4>
        <ul class="footer-links-list">
          <li><a href="#solution">Interchange-Plus Pricing</a></li>
          <li><a href="#solution">Multi-Gateway Routing</a></li>
          <li><a href="#solution">LegitScript High-Risk</a></li>
          <li><a href="#howItWorks">Next-Day Settlement</a></li>
          <li><a href="#rateCalculator">Rate Savings Calculator</a></li>
        </ul>
      </div>

      <!-- Col 3: Integrations -->
      <div class="footer-col">
        <h4 class="footer-col-title">Gateway Partners</h4>
        <ul class="footer-links-list">
          <li><span>NMI Network Gateway</span></li>
          <li><span>Authorize.Net (Visa)</span></li>
          <li><span>Fluidpay Cloud Routing</span></li>
          <li><span>USA ePay Gateway</span></li>
          <li><span>Persona Verification</span></li>
        </ul>
      </div>

      <!-- Col 4: Compliance & Badges -->
      <div class="footer-col">
        <h4 class="footer-col-title">Security & Trust</h4>
        <div class="footer-badges">
          <div class="f-badge">🔒 PCI-DSS Level 1 Certified</div>
          <div class="f-badge">🛡️ LegitScript Certified Partner</div>
          <div class="f-badge">⚡ 99.9% Uptime Guarantee</div>
        </div>
      </div>
    </div>

    <!-- Mandatory Legal FinTech Disclaimer -->
    <div class="footer-legal-box">
      <p>
        <strong>Legal & Financial Disclosure:</strong> OneFunding LLC (operating as 1 Funding Source) is a financial technology company and registered independent sales organization (ISO/MSP) representative, not an FDIC-insured banking institution. Credit card processing and merchant acquiring services are provided through our network of member banking partners, registered ISO/MSPs, and gateway partners including NMI, Authorize.Net, USA ePay, and Fluidpay. All brand names, logos, and registered trademarks belong to their respective holders and are used strictly for identification purposes.
      </p>
    </div>

    <div class="footer-bottom-row">
      <p class="copyright-text">
        © {new Date().getFullYear()} OneFunding LLC / 1 Funding Source. All Rights Reserved.
      </p>
      <div class="legal-links-row">
        <a href="#privacy">Privacy Policy</a>
        <span>·</span>
        <a href="#terms">Terms of Service</a>
        <span>·</span>
        <a href="#security">PCI Compliance</a>
        <span>·</span>
        <a href="#merchant">Merchant Agreement</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    padding: 4rem 0 2rem 0;
    color: #475569;
  }

  .footer-main-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
  }

  .logo-icon-small {
    width: 30px;
    height: 30px;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 800;
    color: #0f172a;
  }

  .footer-tagline {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #64748b;
    margin-bottom: 1.15rem;
    max-width: 320px;
  }

  .footer-contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.86rem;
    color: #475569;
  }

  .footer-contact-details strong {
    color: #0f172a;
  }

  .footer-col-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 1.15rem;
  }

  .footer-links-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.88rem;
  }

  .footer-links-list a {
    color: #475569;
    transition: color var(--transition-fast);
  }

  .footer-links-list a:hover {
    color: var(--emerald-light);
  }

  .footer-badges {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .f-badge {
    padding: 0.35rem 0.65rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    font-weight: 600;
    color: #334155;
  }

  .footer-legal-box {
    padding: 1.25rem 1.5rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-md);
    margin-bottom: 2rem;
  }

  .footer-legal-box p {
    font-size: 0.76rem;
    line-height: 1.6;
    color: #64748b;
  }

  .footer-legal-box strong {
    color: #334155;
  }

  .footer-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid #e2e8f0;
    font-size: 0.8rem;
  }

  .copyright-text {
    color: #64748b;
  }

  .legal-links-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .legal-links-row a {
    color: #475569;
    transition: color var(--transition-fast);
  }

  .legal-links-row a:hover {
    color: var(--emerald-primary);
  }

  @media (max-width: 900px) {
    .footer-main-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .footer-main-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom-row {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }
</style>
