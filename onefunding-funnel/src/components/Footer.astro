---
// Footer.astro - Compliance Disclaimer, Trust Badges, and Global Navigation
import { SITE_CONFIG } from '../config/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-main-grid">
      <!-- Col 1: Brand & Contact -->
      <div class="footer-brand-col">
        <div class="footer-logo">
          <div class="logo-icon-small">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#059669" stroke-width="2.4">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <span class="brand-text">ONEFUNDING LLC</span>
        </div>
        <p class="footer-tagline">
          Enterprise payment orchestration, high-risk underwriting, and Interchange-Plus pricing for scaling merchants.
        </p>
        <div class="footer-contact-details">
          <div>📞 <a href={SITE_CONFIG.phone.href} class="footer-contact-link"><strong>{SITE_CONFIG.phone.display}</strong></a> (24/7 Dedicated Support)</div>
          <div>✉️ <a href={`mailto:${SITE_CONFIG.email}`} class="footer-contact-link"><strong>{SITE_CONFIG.email}</strong></a></div>
        </div>
      </div>

      <!-- Col 2: Solutions -->
      <div class="footer-col">
        <h4 class="footer-col-title">Solutions</h4>
        <ul class="footer-links-list">
          <li><a href="/#solution">Interchange-Plus Pricing</a></li>
          <li><a href="/#solution">Multi-Gateway Routing</a></li>
          <li><a href="/#solution">LegitScript High-Risk</a></li>
          <li><a href="/#howItWorks">Next-Day Settlement</a></li>
          <li><a href={SITE_CONFIG.ctaUrl} target="_blank" rel="noopener noreferrer">Free Rate Audit</a></li>
        </ul>
      </div>

      <!-- Col 3: Integrations -->
      <div class="footer-col">
        <h4 class="footer-col-title">Gateway Partners</h4>
        <ul class="footer-links-list">
          <li><span>NMI Network Gateway</span></li>
          <li><span>Authorize.Net (Visa)</span></li>
          <li><span>Fluidpay Cloud Routing</span></li>
          <li><span>USA ePay Gateway</span></li>
          <li><span>Persona Verification</span></li>
        </ul>
      </div>

      <!-- Col 4: Industries -->
      <div class="footer-col">
        <h4 class="footer-col-title">Industries</h4>
        <ul class="footer-links-list">
          <li><span>Ecommerce &amp; Subscriptions</span></li>
          <li><span>Retail &amp; Restaurant POS</span></li>
          <li><span>Contractors &amp; Field Services</span></li>
          <li><span>Professional &amp; B2B Services</span></li>
          <li><span>Specialized &amp; High-Volume</span></li>
        </ul>
      </div>
    </div>

    <!-- Regulatory Compliance Disclosure Notice -->
    <div class="footer-disclaimer-box">
      <p class="disclaimer-text">
        <strong>Regulatory &amp; Processing Disclosure:</strong> {SITE_CONFIG.disclaimer.iso} {SITE_CONFIG.disclaimer.bank}
      </p>
    </div>

    <!-- Clean Bottom Row with Legal Links & Authentic Security Seals -->
    <div class="footer-bottom-row">
      <div class="copyright-group">
        <p class="copyright-text">
          © {new Date().getFullYear()} {SITE_CONFIG.name}. All Rights Reserved.
        </p>
        <div class="security-seals-inline">
          <span class="seal-item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span>PCI-DSS Level 1 Validated</span>
          </span>
          <span class="seal-sep">•</span>
          <span class="seal-item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.5">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>256-Bit TLS Bank Encryption</span>
          </span>
        </div>
      </div>

      <div class="legal-links-row">
        <a href={SITE_CONFIG.links.privacy}>Privacy Policy</a>
        <span>·</span>
        <a href={SITE_CONFIG.links.terms}>Terms of Service</a>
        <span>·</span>
        <a href={SITE_CONFIG.links.security}>Security &amp; Compliance</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    padding: 4.5rem 0 2.5rem 0;
    color: #475569;
  }

  .footer-main-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
  }

  .logo-icon-small {
    width: 30px;
    height: 30px;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 800;
    color: #0f172a;
  }

  .footer-tagline {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #64748b;
    margin-bottom: 1.25rem;
    max-width: 320px;
  }

  .footer-contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.86rem;
    color: #475569;
  }

  .footer-contact-details strong {
    color: #0f172a;
  }

  .footer-col-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1.15rem;
  }

  .footer-links-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    font-size: 0.88rem;
  }

  .footer-links-list a,
  .footer-links-list span {
    color: #64748b;
    transition: color var(--transition-fast);
  }

  .footer-links-list a:hover {
    color: var(--emerald-primary);
  }

  .footer-contact-link {
    color: inherit;
    transition: color var(--transition-fast);
  }

  .footer-contact-link:hover {
    color: var(--emerald-primary);
  }

  .footer-disclaimer-box {
    padding: 1.25rem 1.5rem;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-md);
    margin-bottom: 2rem;
  }

  .disclaimer-text {
    font-size: 0.78rem;
    line-height: 1.6;
    color: #64748b;
  }

  .disclaimer-text strong {
    color: #334155;
  }

  .footer-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid #e2e8f0;
    font-size: 0.82rem;
    gap: 1.5rem;
  }

  .copyright-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .copyright-text {
    color: #64748b;
  }

  .security-seals-inline {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.76rem;
    font-weight: 600;
    color: #475569;
  }

  .seal-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .seal-sep {
    color: #cbd5e1;
  }

  .legal-links-row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .legal-links-row a {
    color: #64748b;
    transition: color var(--transition-fast);
  }

  .legal-links-row a:hover {
    color: var(--emerald-primary);
  }

  .legal-links-row span {
    color: #cbd5e1;
  }

  @media (max-width: 900px) {
    .footer-main-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }

    .footer-bottom-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }

  @media (max-width: 600px) {
    .footer-main-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

