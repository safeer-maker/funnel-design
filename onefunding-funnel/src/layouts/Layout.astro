---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "OneFunding — Next-Gen Merchant Processing & Zero-Downtime Payments",
  description = "Stop funding Stripe's growth. OneFunding provides Interchange-Plus rates, next-day cash deposits, and multi-gateway underwriting that never gets shut down."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/hero_dashboard.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%2310b981'><path d='M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5'/></svg>" />

    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <div class="ambient-glow"></div>
    <slot />

    <!-- Global High-Performance Text & Section Flow-In Observer Engine -->
    <script>
      function initFlowAnimations() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const flowElements = document.querySelectorAll<HTMLElement>('[data-flow], [data-flow-stagger]');

        if (!flowElements.length) return;

        if (prefersReducedMotion) {
          flowElements.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.12,
            rootMargin: '0px 0px -30px 0px'
          }
        );

        flowElements.forEach((el) => {
          // Immediately reveal elements already visible in initial viewport
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            // Above the fold - reveal with slight natural stagger
            setTimeout(() => {
              el.classList.add('is-revealed');
            }, 60);
          } else {
            observer.observe(el);
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFlowAnimations);
      } else {
        initFlowAnimations();
      }
    </script>
  </body>
</html>
